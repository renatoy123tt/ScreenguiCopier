					e.saved = e.saved or nowStr()
					local o, s, n = nodeStats(e.node)
					e.objects, e.scripts, e.nosrc = o, s, n
					table.insert(library, e)
					added += 1
				end
			end
		end
		sortLibrary()
		persist()
		refreshSaved()
		setStatus(added > 0 and (added .. " backup(s) importado(s). Veja na aba Salvos.") or "Nada novo para importar (já existiam).", added > 0 and "ok" or "warn")
		if added > 0 then
			box.Text = ""
			showPage(2)
		end
	end,
})

