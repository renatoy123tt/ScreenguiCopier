local function makeList(parent, opts)
	local scroll = new("ScrollingFrame", {
		Position = UDim2.fromOffset(12, 0), Size = UDim2.fromOffset(456, 270), BackgroundColor3 = C.surface,
		BorderSizePixel = 0, ScrollBarThickness = 4, ScrollBarImageColor3 = C.accent,
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
	}, parent)
	corner(scroll, 12)
	new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, scroll)
	new("UIPadding", {
		PaddingTop = UDim.new(0, 6), PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 10),
		PaddingBottom = UDim.new(0, 6),
	}, scroll)

	local list = { items = {}, rows = {} }

	function list:set(items)
		local prev = {}
		for _, it in ipairs(self.items) do
			prev[it.id] = it.selected
		end
		for _, r in ipairs(self.rows) do
			r:Destroy()
		end
		self.rows, self.items = {}, items

		if #items == 0 then
			local empty = new("Frame", { Size = UDim2.new(1, 0, 0, 200), BackgroundTransparency = 1 }, scroll)
			new("TextLabel", {
				Position = UDim2.fromOffset(0, 50), Size = UDim2.new(1, 0, 0, 50), BackgroundTransparency = 1,
				Text = ICONS.empty, TextColor3 = C.dim, Font = Enum.Font.GothamBold, TextSize = 36,
			}, empty)
			new("TextLabel", {
				Position = UDim2.fromOffset(0, 104), Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1,
				Text = opts.emptyText or "Nada por aqui.", TextColor3 = C.dim, Font = Enum.Font.Gotham,
				TextSize = 13, TextWrapped = true,
			}, empty)
			table.insert(self.rows, empty)
			return
		end

		for i, it in ipairs(items) do
			if prev[it.id] ~= nil then
				it.selected = prev[it.id]
			else
				it.selected = false
			end

			local row = new("TextButton", {
				Size = UDim2.new(1, 0, 0, 52), BackgroundColor3 = C.surface2, BackgroundTransparency = 1,
				Text = "", AutoButtonColor = false, LayoutOrder = i,
			}, scroll)
			corner(row, 10)
			local rs = new("UIStroke", { Color = C.accent, Thickness = 1.5, Transparency = 1 }, row)

			local box = new("Frame", {
				AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 12, 0.5, 0),
				Size = UDim2.fromOffset(22, 22), BackgroundColor3 = C.gray,
			}, row)
			corner(box, 6)
			local mark = new("TextLabel", {
				Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", TextColor3 = C.text,
				Font = Enum.Font.GothamBold, TextSize = 15,
			}, box)

			new("TextLabel", {
				Position = UDim2.fromOffset(42, 0), Size = UDim2.fromOffset(26, 52), BackgroundTransparency = 1,
				Text = ICONS.gui, TextColor3 = C.text, Font = Enum.Font.GothamBold, TextSize = 18,
			}, row)

			local rightMargin = opts.deletable and 56 or 14
			new("TextLabel", {
				Position = UDim2.fromOffset(74, 8), Size = UDim2.new(1, -(74 + rightMargin), 0, 18),
				BackgroundTransparency = 1, Text = it.name, TextColor3 = C.text, Font = Enum.Font.GothamBold,
				TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
			}, row)
			new("TextLabel", {
				Position = UDim2.fromOffset(74, 27), Size = UDim2.new(1, -(74 + rightMargin), 0, 16),
				BackgroundTransparency = 1, Text = it.sub, TextColor3 = C.dim, Font = Enum.Font.Gotham,
				TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
			}, row)

			local function paint(animated)
				local t = animated and 0.15 or 0
				tween(box, t, { BackgroundColor3 = it.selected and C.accent or C.gray })
				tween(rs, t, { Transparency = it.selected and 0 or 1 })
				mark.Text = it.selected and ICONS.check or ""
			end
			it._paint = paint
			paint(false)

			row.MouseEnter:Connect(function()
				tween(row, 0.12, { BackgroundColor3 = C.surface2:Lerp(Color3.new(1, 1, 1), 0.06) })
			end)
			row.MouseLeave:Connect(function()
				tween(row, 0.12, { BackgroundColor3 = C.surface2 })
			end)
			row.Activated:Connect(function()
				it.selected = not it.selected
				paint(true)
			end)

			if opts.deletable then
				local del = new("TextButton", {
					AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0),
					Size = UDim2.fromOffset(34, 34), BackgroundColor3 = C.surface, AutoButtonColor = false,
					Text = ICONS.trash, TextColor3 = C.dim, Font = Enum.Font.GothamBold, TextSize = 16,
				}, row)
				corner(del, 9)
				local armed = false
				del.Activated:Connect(function()
					if not armed then
						armed = true
						del.Text = "?"
						tween(del, 0.15, { BackgroundColor3 = C.danger })
						tween(del, 0.15, { TextColor3 = C.text })
						if opts.onArm then
							opts.onArm(it)
						end
						task.delay(2.5, function()
							if armed and del.Parent then
								armed = false
								del.Text = ICONS.trash
								tween(del, 0.15, { BackgroundColor3 = C.surface })
								tween(del, 0.15, { TextColor3 = C.dim })
							end
						end)
					else
						armed = false
						if opts.onDelete then
							opts.onDelete(it)
						end
					end
				end)
			end

			-- entrada suave
			task.delay(math.min(i, 10) * 0.03, function()
				if row.Parent then
					tween(row, 0.25, { BackgroundTransparency = 0 })
				end
			end)
			table.insert(self.rows, row)
		end
	end

	function list:setAll(state)
		for _, it in ipairs(self.items) do
			it.selected = state
			if it._paint then
				it._paint(true)
			end
		end
	end

	function list:getSelected()
		local out = {}
		for _, it in ipairs(self.items) do
			if it.selected then
				table.insert(out, it)
			end
		end
		return out
	end

	return list
end

