-- Restauração
local function uniqueName(base)
	local name, n = base, 1
	while StarterGui:FindFirstChild(name) do
		n += 1
		name = base .. "_Restaurada" .. (n > 2 and tostring(n - 1) or "")
	end
	return name
end

local function restoreEntries(entries)
	local created, failed = 0, 0
	local st = { srcOk = 0, srcFail = 0, nosrc = 0 }
	for _, e in ipairs(entries) do
		local name = uniqueName((e.node.p and e.node.p.Name) or e.name or e.node.c)
		local ok, inst = pcall(build, e.node, StarterGui, st, name)
		if ok and inst then
			created += 1
			local lp = Players.LocalPlayer
			if lp and RunService:IsRunning() then
				pcall(function()
					inst:Clone().Parent = lp:WaitForChild("PlayerGui")
				end)
			end
		else
			failed += 1
		end
	end
	local msg = ("%d ScreenGui(s) restaurada(s) no StarterGui"):format(created)
	local kind = "ok"
	if st.srcOk > 0 then
		msg ..= (" • %d script(s) com código"):format(st.srcOk)
	end
	if st.srcFail > 0 then
		msg ..= (" • ⚠ %d script(s) sem poder gravar o código (guardado no atributo OriginalSource)"):format(st.srcFail)
		kind = "warn"
	end
	if st.nosrc > 0 then
		msg ..= (" • ⚠ %d script(s) já estavam sem código no backup"):format(st.nosrc)
		kind = "warn"
	end
	if failed > 0 then
		msg ..= (" • %d falharam"):format(failed)
		kind = "err"
	end
	setStatus(msg .. ".", kind)
	refreshCopy()
end

