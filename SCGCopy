-- Ícone flutuante, minimizar / expandir
------------------------------------------------------------------
local icon = new("Frame", {
	Name = "FloatingIcon", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, -44, 0.5, 0),
	Size = UDim2.fromOffset(56, 56), BackgroundColor3 = C.accent, Visible = false, Active = true,
}, screen)
corner(icon, 28)
new("UIGradient", { Color = ColorSequence.new(C.accent, C.accent2), Rotation = 45 }, icon)
new("UIStroke", { Color = Color3.fromRGB(255, 255, 255), Thickness = 2, Transparency = 0.6 }, icon)
local iconScale = new("UIScale", { Scale = 0 }, icon)
new("TextLabel", {
	Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = ICONS.app, TextColor3 = C.text,
	Font = Enum.Font.GothamBold, TextSize = 26,
}, icon)
local iconQuit = new("TextButton", {
	AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, -6, 0, 6), Size = UDim2.fromOffset(20, 20),
	BackgroundColor3 = C.danger, Text = ICONS.close, TextColor3 = C.text, Font = Enum.Font.GothamBold,
	TextSize = 10, AutoButtonColor = false, ZIndex = 3,
}, icon)
corner(iconQuit, 10)

local state = { minimized = false, busy = false, lastPos = root.Position }

local function iconCenter()
	local size = screenSize()
	local p = icon.Position
	return UDim2.fromOffset(p.X.Scale * size.X + p.X.Offset, p.Y.Scale * size.Y + p.Y.Offset)
end

function minimize()
	if state.minimized or state.busy then
		return
	end
	state.busy = true
	state.lastPos = root.Position
	local target = iconCenter()
	tween(rootScale, 0.28, { Scale = 0.1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	tween(root, 0.28, { Position = target }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	tween(main, 0.26, { GroupTransparency = 1 })
	task.delay(0.3, function()
		root.Visible = false
		icon.Visible = true
		iconScale.Scale = 0
		tween(iconScale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
		state.minimized = true
		state.busy = false
	end)
end

function expand()
	if not state.minimized or state.busy then
		return
	end
	state.busy = true
	root.Position = iconCenter()
	rootScale.Scale = 0.1
	main.GroupTransparency = 1
	root.Visible = true
	tween(iconScale, 0.18, { Scale = 0 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	task.delay(0.18, function()
		icon.Visible = false
	end)
	tween(rootScale, 0.38, { Scale = fitScale() }, Enum.EasingStyle.Back)
	tween(root, 0.38, { Position = state.lastPos }, Enum.EasingStyle.Quint)
	tween(main, 0.3, { GroupTransparency = 0 })
	task.delay(0.4, function()
		state.minimized = false
		state.busy = false
	end)
end

function quit()
	tween(iconScale, 0.2, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
	task.delay(0.22, function()
		screen:Destroy()
	end)
end
iconQuit.Activated:Connect(function()
	quit()
end)

makeDraggable(header, root)
makeDraggable(icon, icon, function()
	expand()
end)

