local listCopy, listSaved

local function describe(objects, scripts, nosrc)
	local s = objects .. " objetos"
	if scripts > 0 then
		s ..= "  •  " .. scripts .. (scripts == 1 and " script" or " scripts")
		if nosrc and nosrc > 0 then
			s ..= " (" .. nosrc .. " sem código)"
		end
	end
	return s
end

local function refreshCopy()
	local items = {}
	for _, g in ipairs(StarterGui:GetChildren()) do
		if g:IsA("ScreenGui") then
			local desc = g:GetDescendants()
			local scripts = 0
			for _, d in ipairs(desc) do
				if d:IsA("LuaSourceContainer") then
					scripts += 1
				end
			end
			table.insert(items, {
				id = "gui_" .. g.Name .. "_" .. tostring(#items + 1),
				name = g.Name,
				sub = describe(#desc + 1, scripts),
				data = g,
			})
		end
	end
	listCopy:set(items)
	if #items == 0 then
		setStatus("Nenhuma ScreenGui encontrada no StarterGui.", "warn")
	end
	return #items
end

local function refreshSaved()
	local items = {}
	for _, e in ipairs(library) do
		table.insert(items, {
			id = e.id,
			name = e.name,
			sub = e.saved .. "  •  " .. describe(e.objects or 0, e.scripts or 0, e.nosrc or 0),
			data = e,
		})
	end
	listSaved:set(items)
	tabs[2].Text = ICONS.saved .. "  Salvos" .. (#library > 0 and (" (" .. #library .. ")") or "")
end

