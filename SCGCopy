local function propsFor(inst)
	local list, seen = {}, {}
	for _, g in ipairs(GROUPS) do
		local ok, match = pcall(function()
			if type(g[1]) == "string" then
				return inst:IsA(g[1])
			end
			return g[1](inst)
		end)
		if ok and match then
			for _, p in ipairs(g[2]) do
				if not seen[p] then
					seen[p] = true
					table.insert(list, p)
				end
			end
		end
	end
	return list
end

------------------------------------------------------------------
-- CODIFICAÇÃO / DECODIFICAÇÃO DE VALORES
------------------------------------------------------------------
local function enc(v)
	local t = typeof(v)
	if t == "boolean" or t == "string" then
		return v
	elseif t == "number" then
		if v ~= v or v == math.huge or v == -math.huge then
			return nil
		end
		return v
	elseif t == "Color3" then
		return { _t = "Color3", v = { v.R, v.G, v.B } }
	elseif t == "UDim2" then
		return { _t = "UDim2", v = { v.X.Scale, v.X.Offset, v.Y.Scale, v.Y.Offset } }
	elseif t == "UDim" then
		return { _t = "UDim", v = { v.Scale, v.Offset } }
	elseif t == "Vector2" then
		return { _t = "Vector2", v = { v.X, v.Y } }
	elseif t == "Vector3" then
		return { _t = "Vector3", v = { v.X, v.Y, v.Z } }
	elseif t == "Rect" then
		return { _t = "Rect", v = { v.Min.X, v.Min.Y, v.Max.X, v.Max.Y } }
	elseif t == "NumberRange" then
		return { _t = "NumberRange", v = { v.Min, v.Max } }
	elseif t == "NumberSequence" then
		local k = {}
		for _, kp in ipairs(v.Keypoints) do
			table.insert(k, { kp.Time, kp.Value, kp.Envelope })
		end
		return { _t = "NumberSequence", v = k }
	elseif t == "ColorSequence" then
		local k = {}
		for _, kp in ipairs(v.Keypoints) do
			table.insert(k, { kp.Time, kp.Value.R, kp.Value.G, kp.Value.B })
		end
		return { _t = "ColorSequence", v = k }
	elseif t == "EnumItem" then
		return { _t = "Enum", e = tostring(v.EnumType), n = v.Name }
	elseif t == "Font" then
		return { _t = "Font", f = v.Family, w = v.Weight.Name, s = v.Style.Name }
	end
	return nil
end

local function dec(e)
	if type(e) ~= "table" then
		return e
	end
	local t, v = e._t, e.v
	if t == "Color3" then
		return Color3.new(v[1], v[2], v[3])
	elseif t == "UDim2" then
		return UDim2.new(v[1], v[2], v[3], v[4])
	elseif t == "UDim" then
		return UDim.new(v[1], v[2])
	elseif t == "Vector2" then
		return Vector2.new(v[1], v[2])
	elseif t == "Vector3" then
		return Vector3.new(v[1], v[2], v[3])
	elseif t == "Rect" then
		return Rect.new(v[1], v[2], v[3], v[4])
	elseif t == "NumberRange" then
		return NumberRange.new(v[1], v[2])
	elseif t == "NumberSequence" then
		local k = {}
		for _, p in ipairs(v) do
			table.insert(k, NumberSequenceKeypoint.new(p[1], p[2], p[3] or 0))
		end
		return NumberSequence.new(k)
	elseif t == "ColorSequence" then
		local k = {}
		for _, p in ipairs(v) do
			table.insert(k, ColorSequenceKeypoint.new(p[1], Color3.new(p[2], p[3], p[4])))
		end
		return ColorSequence.new(k)
	elseif t == "Enum" then
		local ok, item = pcall(function()
			return Enum[e.e][e.n]
		end)
		return ok and item or nil
	elseif t == "Font" then
		local ok, f = pcall(function()
			return Font.new(e.f, Enum.FontWeight[e.w], Enum.FontStyle[e.s])
		end)
		return ok and f or nil
	end
	return nil
end

------------------------------------------------------------------
-- SERIALIZAR / RECONSTRUIR
------------------------------------------------------------------
local defaults = {}
local function getDefault(class)
	if defaults[class] == nil then
		local ok, o = pcall(Instance.new, class)
		defaults[class] = ok and o or false
	end
	return defaults[class]
end

local function sameEnc(a, b)
	return HttpService:JSONEncode({ a }) == HttpService:JSONEncode({ b })
end

-- Lê o código de um script (Source ou decompile como alternativa)
local function readSource(inst)
	local ok, src = pcall(function()
		return inst.Source
	end)
	if ok and type(src) == "string" then
		return src
	end
	if type(decompile) == "function" then
		local ok2, r = pcall(decompile, inst)
		if ok2 and type(r) == "string" and #r > 0 then
			return r
		end
	end
	return nil
end

local function serialize(inst)
	local node = { c = inst.ClassName, p = {}, ch = {} }
	local def = getDefault(inst.ClassName)

	for _, prop in ipairs(propsFor(inst)) do
		local ok, val = pcall(function()
			return inst[prop]
		end)
		if ok then
			local e = enc(val)
			if e ~= nil then
				local keep = (prop == "Name")
				if not keep then
					if def then
						local ok2, dv = pcall(function()
							return def[prop]
						end)
						if ok2 then
							local de = enc(dv)
							keep = not (de ~= nil and sameEnc(e, de))
						else
							keep = true
						end
					else
						keep = true
					end
				end
				if keep then
					node.p[prop] = e
				end
			end
		end
	end

	-- Código dos scripts (LocalScript, Script, ModuleScript)
	if inst:IsA("LuaSourceContainer") then
		local src = readSource(inst)
		if src ~= nil then
			if src ~= "" then
				node.p.Source = src
			end
		else
			node.nosrc = true
		end
	end

	local okA, attrs = pcall(function()
		return inst:GetAttributes()
	end)
	if okA and next(attrs) then
		node.a = {}
		for k, v in pairs(attrs) do
			local e = enc(v)
			if e ~= nil then
				node.a[k] = e
			end
		end
	end

	local okT, tags = pcall(function()
		return CollectionService:GetTags(inst)
	end)
	if okT and #tags > 0 then
		node.tg = tags
	end

	if not inst:IsA("ViewportFrame") then
		for _, child in ipairs(inst:GetChildren()) do
			table.insert(node.ch, serialize(child))
		end
	end
	return node
end

-- retorna: objetos, scripts, scripts sem código
local function nodeStats(node)
	local o, s, n = 1, 0, 0
	if node.c == "LocalScript" or node.c == "Script" or node.c == "ModuleScript" then
		s = 1
		if node.nosrc then
			n = 1
		end
	end
	for _, c in ipairs(node.ch or {}) do
		local a, b, d = nodeStats(c)
		o += a
		s += b
		n += d
	end
	return o, s, n
end

local function build(node, parent, st, rootName)
	local ok, inst = pcall(Instance.new, node.c)
	if not ok or not inst then
		return nil
	end
	for prop, val in pairs(node.p or {}) do
		local v = dec(val)
		if v ~= nil then
			local okSet = pcall(function()
				inst[prop] = v
			end)
			if prop == "Source" then
				if okSet then
					st.srcOk += 1
				else
					st.srcFail += 1
					if type(v) == "string" and #v <= 100000 then
						pcall(inst.SetAttribute, inst, "OriginalSource", v)
					end
				end
			end
		end
	end
	if node.nosrc then
		st.nosrc += 1
	end
	for k, val in pairs(node.a or {}) do
		local v = dec(val)
		if v ~= nil then
			pcall(function()
				inst:SetAttribute(k, v)
			end)
		end
	end
	for _, tag in ipairs(node.tg or {}) do
		pcall(function()
			CollectionService:AddTag(inst, tag)
		end)
	end
	if rootName then
		inst.Name = rootName
	end
	for _, ch in ipairs(node.ch or {}) do
		build(ch, inst, st)
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

------------------------------------------------------------------
-- BIBLIOTECA DE BACKUPS (persistência)
------------------------------------------------------------------
local hasWrite = type(writefile) == "function"
local hasRead = type(readfile) == "function"

local library = {} -- { id, name, saved, objects, scripts, nosrc, node }

local function newId()
	local ok, g = pcall(function()
		return HttpService:GenerateGUID(false)
	end)
	return ok and g or (tostring(os.time()) .. tostring(math.random(1000, 9999)))
end

local function nowStr()
	return os.date("%Y-%m-%d %H:%M:%S")
end

local function sortLibrary()
	table.sort(library, function(a, b)
		if a.saved ~= b.saved then
			return a.saved > b.saved
		end
		return a.id > b.id
	end)
end

local function loadLibrary()
	library = {}
	local seen = {}
	local function add(e)
		if type(e) == "table" and e.id and type(e.node) == "table" and not seen[e.id] then
			seen[e.id] = true
			table.insert(library, e)
		end
	end
	if hasRead then
		local okE, exists = pcall(function()
			return type(isfile) ~= "function" or isfile(LIB_FILE)
		end)
		if okE and exists then
			local ok, txt = pcall(readfile, LIB_FILE)
			if ok and txt and #txt > 0 then
				local ok2, data = pcall(HttpService.JSONDecode, HttpService, txt)
				if ok2 and type(data) == "table" and type(data.entries) == "table" then
					for _, e in ipairs(data.entries) do
						add(e)
					end
				end
			end
		end
	end
	pcall(function()
		local folder = ServerStorage:FindFirstChild(STORE_FOLDER)
		if folder then
			for _, sv in ipairs(folder:GetChildren()) do
				if sv:IsA("StringValue") then
					local ok, e = pcall(HttpService.JSONDecode, HttpService, sv.Value)
					if ok then
						add(e)
					end
				end
			end
		end
	end)
	sortLibrary()
end

-- grava a biblioteca inteira; retorna lista de locais e aviso opcional
local function persist()
	local where, warning = {}, nil
	if hasWrite then
		local ok = pcall(function()
			writefile(LIB_FILE, HttpService:JSONEncode({ version = 2, entries = library }))
		end)
		if ok then
			table.insert(where, 'arquivo "' .. LIB_FILE .. '"')
		end
	end
	local okS = pcall(function()
		local folder = ServerStorage:FindFirstChild(STORE_FOLDER)
		if not folder then
			folder = Instance.new("Folder")
			folder.Name = STORE_FOLDER
			folder.Parent = ServerStorage
		end
		local keep = {}
		for _, e in ipairs(library) do
			local json = HttpService:JSONEncode(e)
			if #json <= STORE_LIMIT then
				local sv = folder:FindFirstChild(e.id)
				if not sv then
					sv = Instance.new("StringValue")
					sv.Name = e.id
					sv.Parent = folder
				end
				sv.Value = json
				keep[e.id] = true
			else
				warning = "Um backup é grande demais para o ServerStorage (ficou só no arquivo/exportação)."
			end
		end
		for _, c in ipairs(folder:GetChildren()) do
			if not keep[c.Name] then
				c:Destroy()
			end
		end
	end)
	if okS then
		table.insert(where, "ServerStorage." .. STORE_FOLDER)
	end
	return where, warning
end

local function copyToClipboard(txt)
	local fn = (type(setclipboard) == "function" and setclipboard) or (type(toclipboard) == "function" and toclipboard)
	if fn then
		return (pcall(fn, txt))
	end
	return false
end

