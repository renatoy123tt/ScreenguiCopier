local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props or {}) do
		o[k] = v
	end
	o.Parent = parent
	return o
end

local function corner(o, r)
	return new("UICorner", { CornerRadius = UDim.new(0, r or 8) }, o)
end

local function tween(o, t, props, style, dir)
	local tw = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

local conns = {}
local function track(c)
	table.insert(conns, c)
	return c
end

local function makeButton(parent, cfg)
	local base = cfg.color or C.gray
	local b = new("TextButton", {
		Position = cfg.pos, Size = cfg.size, BackgroundColor3 = base, AutoButtonColor = false,
		Text = cfg.text or "", TextColor3 = C.text, Font = Enum.Font.GothamBold,
		TextSize = cfg.textSize or 13, TextWrapped = true,
	}, parent)
	corner(b, cfg.radius or 10)
	new("UIGradient", {
		Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(200, 200, 212)), Rotation = 90,
	}, b)
	local sc = new("UIScale", {}, b)
	local hover = base:Lerp(Color3.new(1, 1, 1), 0.14)
	b.MouseEnter:Connect(function()
		tween(b, 0.12, { BackgroundColor3 = hover })
	end)
	b.MouseLeave:Connect(function()
		tween(b, 0.12, { BackgroundColor3 = base })
		tween(sc, 0.1, { Scale = 1 })
	end)
	b.MouseButton1Down:Connect(function()
		tween(sc, 0.08, { Scale = 0.95 })
	end)
	b.MouseButton1Up:Connect(function()
		tween(sc, 0.14, { Scale = 1 }, Enum.EasingStyle.Back)
	end)
	if cfg.callback then
		b.Activated:Connect(cfg.callback)
	end
	return b
end

local function makeDraggable(handle, target, onClick)
	local dragging, moved, startInput, startPos = false, false, nil, nil
	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging, moved = true, false
			startInput = input.Position
			startPos = target.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
					if not moved and onClick then
						onClick()
					end
				end
			end)
		end
	end)
	track(UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local d = input.Position - startInput
			if d.Magnitude > 6 then
				moved = true
			end
			if moved then
				target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
			end
		end
	end))
end

